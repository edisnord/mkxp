diff --git a/src/platform/platform_sdl2.c b/src/platform/platform_sdl2.c
index a69f6f9..507b1c8 100644
--- a/src/platform/platform_sdl2.c
+++ b/src/platform/platform_sdl2.c
@@ -972,6 +972,16 @@ Platform *platform_init(const char *title, int width, int height)
             height = mode.h;
         }
     }
+#ifdef RMMZ_PS5_GPU
+    /* Native title with GPU OpenGL (ps5-opengl): its SDL driver takes exactly one fixed, display-sized
+       window and an OpenGL 3.3 core context request. Mesa returns its newest core version for that, which
+       has the direct state access of 4.5. */
+    flags = SDL_WINDOW_OPENGL;
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 3);
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_CORE);
+    SDL_GL_SetAttribute(SDL_GL_DOUBLEBUFFER, 1);
+#endif
 #else
     /* OpenGL 4.5: the renderer relies on direct state access. */
     SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 4);
@@ -1277,7 +1287,7 @@ void platform_request_dump(Platform *p, const char *path)
 
 bool platform_cpu_present_available(Platform *p)
 {
-#ifdef __SCE__
+#if defined(__SCE__) && !defined(RMMZ_PS5_GPU)
     if (s_cpu_present_off < 0) s_cpu_present_off = getenv("RMMZ_GL_PRESENT") != NULL;
     return !s_cpu_present_off && p && p->window;
 #else
